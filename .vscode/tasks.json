{
  // Terminal > Run Task… (or Ctrl+Shift+B for "build"). You'll be asked for the environment/target.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "flutter build <target> --flavor <env> --<mode>",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build", "${input:target}",
        "--flavor", "${input:flavor}",
        "--${input:mode}",
        "--dart-define-from-file=config/env/${input:flavor}.json"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "run",
      "detail": "flutter run --flavor <env> --<mode> (terminal; use F5 to debug)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--flavor", "${input:flavor}",
        "--${input:mode}",
        "--dart-define-from-file=config/env/${input:flavor}.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "backend: start db",
      "detail": "docker compose up postgres + redis (uses .env) and wait until healthy",
      "type": "shell",
      "command": "docker compose up -d --wait postgres redis",
      // Windows dev box uses a native PostgreSQL service instead of Docker (see backend/scripts/setup-local-db.ps1).
      "windows": {
        "command": "if ((Get-Service postgresql* -ErrorAction SilentlyContinue | Where-Object Status -eq 'Running')) { 'PostgreSQL service is running' } else { Write-Error 'PostgreSQL service not running - start it in services.msc'; exit 1 }"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: setup local db (Windows)",
      "detail": "Create/update khmerbank role + database in native PostgreSQL using DB_PASSWORD from .env (asks for postgres password)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File backend/scripts/setup-local-db.ps1",
      "problemMatcher": []
    },
    {
      "label": "backend: reset db",
      "detail": "Delete Postgres/Redis containers + volumes (re-init with current .env passwords). DESTROYS local data.",
      "type": "shell",
      "command": "docker compose down -v --remove-orphans; docker rm -f khmerbank-pg; docker volume rm khmerbank_pgdata; docker compose up -d --wait postgres redis",
      "problemMatcher": []
    },
    { "label": "pub get", "type": "shell", "command": "flutter pub get", "problemMatcher": [] },
    { "label": "analyze", "type": "shell", "command": "flutter analyze", "problemMatcher": [] },
    { "label": "test",    "type": "shell", "command": "flutter test",    "group": "test", "problemMatcher": [] },
    { "label": "clean",   "type": "shell", "command": "flutter clean; flutter pub get", "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "flavor", "type": "pickString", "description": "Environment", "options": ["dev", "sit", "uat", "preprod", "prod"], "default": "dev" },
    { "id": "mode",   "type": "pickString", "description": "Build mode",  "options": ["debug", "profile", "release"], "default": "release" },
    { "id": "target", "type": "pickString", "description": "Target",      "options": ["apk", "appbundle", "ios", "ipa"], "default": "apk" }
  ]
}

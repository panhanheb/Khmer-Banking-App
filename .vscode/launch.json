{
  // Run and Debug panel (F5): pick an environment + mode.
  // Values per environment (API_BASE_URL, …) live in config/env/<flavor>.json.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "KhmerBankApplication",
      "request": "launch",
      "mainClass": "com.khmerbank.KhmerBankApplication",
      "projectName": "khmer-digital-bank",
      // Same DB_PASSWORD / secrets as docker compose.
      "envFile": "${workspaceFolder}/.env",
      // Starts postgres + redis via docker compose before launching.
      "preLaunchTask": "backend: start db"
    },
    {
      "name": "dev · debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file=config/env/dev.json"
      ]
    },
    {
      "name": "dev · release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file=config/env/dev.json"
      ]
    },
    {
      "name": "sit · debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
